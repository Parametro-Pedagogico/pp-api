# CENTRAL (pp-api) — produção na VM. Copie para .env e preencha. NÃO comitar o .env.

# Banco: via Cloud SQL Auth Proxy (serviço cloudsql no compose). asyncpg + host do proxy.
CLOUDSQL_INSTANCE=studious-union-475223-m8:southamerica-east1:pp-central
DATABASE_URL=postgresql+asyncpg://pp_app:SENHA@cloudsql:5432/pp_db

# Segredos (gerar fortes; idealmente via Secret Manager)
JWT_SECRET=                      # >= 32 caracteres
REFRESH_TOKEN_PEPPER=            # >= 16 caracteres

# Firebase (login único)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS (origens do frontend)
CORS_ORIGINS=https://app.parametropedagogico.com

# --- Barramento (ligar quando os tópicos existirem; ver infra-gcp.md) ---
GCP_PROJECT=studious-union-475223-m8
EVENTS_PUBLISH_ENABLED=false
PUBSUB_TOPIC_REPLICATION=replicacao
PUBSUB_TOPIC_RESULTS=resultados
RELAY_INTERVAL_SECONDS=5

# Segurança do push de resultado (obrigatório em produção)
PUBSUB_PUSH_AUDIENCE=https://central.parametropedagogico.com/v1/events/resultado
PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@studious-union-475223-m8.iam.gserviceaccount.com
