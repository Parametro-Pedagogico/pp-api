# CENTRAL (pp-api) em Cloud Run. Estas variáveis entram no deploy via --set-env-vars
# (e os segredos via --set-secrets apontando para o Secret Manager). NÃO comitar valores reais.

# Banco: Cloud SQL pelo socket do conector (deploy com --add-cloudsql-instances=<connectionName>).
DATABASE_URL=postgresql+asyncpg://pp_app:SENHA@/pp_db?host=/cloudsql/studious-union-475223-m8:southamerica-east1:pp-central

# Segredos (preferir --set-secrets com o Secret Manager a colocar o valor aqui)
JWT_SECRET=                      # >= 32 caracteres
REFRESH_TOKEN_PEPPER=            # >= 16 caracteres

# Firebase (login único)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CORS (o frontend que chama a API)
CORS_ORIGINS=https://app.parametropedagogico.com

# Arquivos: Cloud Run não tem disco persistente -> armazenamento em GCS (a SA do serviço escreve).
ATTENDANCE_SHEET_STORAGE_BACKEND=gcs
GCS_ATTENDANCE_SHEETS_BUCKET=studious-union-475223-m8-artefatos-provas

# Barramento
GCP_PROJECT=studious-union-475223-m8
EVENTS_PUBLISH_ENABLED=true
PUBSUB_TOPIC_REPLICATION=replicacao
PUBSUB_TOPIC_RESULTS=resultados

# Segurança do push de resultado (obrigatório)
PUBSUB_PUSH_AUDIENCE=https://plataforma.parametropedagogico.com/v1/events/resultado
PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@studious-union-475223-m8.iam.gserviceaccount.com
